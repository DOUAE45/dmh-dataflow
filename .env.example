# Copier ce fichier en .env puis remplacer chaque "change-me".
#   cp .env.example .env
# Générer un mot de passe :  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Le fichier .env est ignoré par Git : il ne doit JAMAIS être commité.

# --- Environnement ---
DMH_ENV=dev

# --- PostgreSQL : super-utilisateur du conteneur (administration uniquement) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me

# Port exposé sur la machine hôte, uniquement en 127.0.0.1.
# 5433 car un PostgreSQL local (Homebrew) occupe déjà 5432.
POSTGRES_HOST_PORT=5433

# --- Base applicative DMH (pipeline, Streamlit, tests) ---
DMH_DB_HOST=localhost
DMH_DB_PORT=5433
DMH_DB_NAME=dmh
DMH_DB_USER=dmh_app
DMH_DB_PASSWORD=change-me

# --- Base de métadonnées Airflow (utilisée à l'étape 4) ---
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me

# --- Dossiers de données ---
DMH_DATA_DIR=./data

# --- Supervision (étape 4) : laisser vide pour désactiver l'envoi des métriques ---
DMH_PUSHGATEWAY_URL=
